# ============================
# 🐘 POSTGRESQL (Base de datos principal)
# ============================
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecobahia
DB_PASSWORD=tu_password_aqui
DB_NAME=ecobahia_db

# ============================
# 🌐 SERVIDOR API
# ============================
PORT=3007
NODE_ENV=development

# ============================
# 🔐 SEGURIDAD JWT
# ============================
# CAMBIAR por una clave segura en producción (mínimo 32 caracteres)
JWT_SECRET=tu_clave_secreta_muy_segura_aqui

# ============================
# 🌍 API EXTERNA (API del Profesor)
# ============================
API_BASE_URL=https://apirecoleccion.gonzaloandreslucio.com/api

# UUID del perfil registrado en la API externa del profesor
PERFIL_ID=tu-uuid-de-perfil-aqui

# ============================
# 🔒 CORS — Orígenes permitidos (separados por coma)
# ============================
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,http://localhost
